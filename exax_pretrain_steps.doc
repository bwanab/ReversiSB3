1. build the wthor database
<cmd tbd>

2. add edax games where edax levels 7,8,9 are played against wthor_rl_CNN_test model.
python generate_edax_bc_dataset.py \
    --games 9000 \
    --depths 7,8,9 \
    --model models/wthor_rl_CNN_test \
    --model-ratio 0.8 \
    --merge wthor_bc_dataset_with_values.pkl \
    --output combined_bc_dataset.pkl

3. pretrain:
python bc_train.py \
    --dataset combined_bc_dataset.pkl \
    --model edax_bc_pretrained \
    --epochs 20 \
    --batch-size 256 \
    --learning-rate 1e-4 \
    --net-width 512

4. After looking at results, select epoch18 as the most promising. Start RL training with:
python sb-train.py --mode edax-curriculum \
    --edax-depths 1,2,3 \
    --edax-ratios 0.3,0.3,0.3 \
    --random-ratio 0.1 \
    --timesteps 500000 \
    -m edax_bc_pretrained \
    --refresh-interval 100000 \
    -lr 1e-5

edax-2 95%, edax-3 75%, edax-4 0%

5. self-train
python sb-train.py --mode selfplay \
    --random-ratio 0.1 \
    --timesteps 500000 \
    -m edax_bc_pretrained \
    --refresh-interval 100000 \
    -lr 1e-5

edax-3 1%

